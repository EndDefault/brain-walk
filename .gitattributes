* text=auto
*.kt text eol=lf
*.kts text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.toml text eol=lf
*.properties text eol=lf
gradlew text eol=lf
gradlew.bat text eol=crlf
*.jar binary
*.png binary
*.otf binary
*.safetensors binary
# Keep Python source stable and preserve packaged artifact checksum bytes on every OS.
training/**/*.py text eol=lf
models/question-author/** -text whitespace=cr-at-eol
licenses/Qwen3-0.6B/LICENSE.txt -text
# Preserve upstream font license text, including its original trailing spaces.
licenses/Pretendard-OFL-1.1.txt text eol=lf whitespace=-blank-at-eol
app/src/main/assets/licenses/Pretendard-OFL-1.1.txt text eol=lf whitespace=-blank-at-eol
